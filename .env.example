# Copy to .env and fill in. Never commit .env.
# Ask before creating paid keys. Do not call paid APIs until keys are set.

# --- Tinker (Thinking Machines) ---
# Sign up: https://tinker.thinkingmachines.ai/
# Create a key in the Tinker Console. Claim Hacktoberfest credits at
# https://hacktoberfest.com/my/promos
# Required for LoRA SFT and hosted sampling of the fine-tuned Qwen3-8B.
TINKER_API_KEY=
PILLCLERK_TINKER_PATH=   # tinker://.../sampler_weights/... after SFT (PARSER_BACKEND=tinker)

# --- Google AI Studio / Gemini API (Gemma 4 31B teacher) ---
# Create a key at https://aistudio.google.com/apikey
# Official model id (Gemini API list): gemma-4-31b-it
# Ask before spending. Do not send photographed prescriptions until PII is stripped.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it

# --- Optional: Backboard (same ChatBackend interface) ---
# Dashboard → Settings → API Keys. https://docs.backboard.io/authentication
# Leave empty unless LLM_BACKEND=backboard. The app does not depend on Backboard.
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_LLM_PROVIDER=google
BACKBOARD_MODEL_NAME=gemma-4-31b-it

# --- Backend switches ---
# LLM_BACKEND: messy-text render + teacher parse-back
#   template  = free Python templates (default, no key)
#   gemini    = Google AI Studio Gemma 4 31B (GEMINI_API_KEY)
#   backboard = optional, uses BACKBOARD_API_KEY
#   tinker    = reserved (TINKER_API_KEY)
# DigitalOcean is dropped. There is no LLM_BACKEND=digitalocean.
LLM_BACKEND=template

# EXTRACT_BACKEND: photo → raw prescription lines
#   manual  = paste / type / WhatsApp (default, no model)
#   ollama  = local gemma4:e4b (needs ~7–10 GB disk)
#   gemini  = Google AI Studio Gemma 4 31B vision (GEMINI_API_KEY)
EXTRACT_BACKEND=manual

# PARSER_BACKEND: messy line → MedLine JSON (fine-tuned Qwen3-8B)
#   tinker  = hosted Tinker sampling API (default; no local GGUF)
#   ollama  = local pillclerk GGUF (not used this weekend; disk-constrained)
PARSER_BACKEND=tinker

# Local Ollama tags if EXTRACT_BACKEND=ollama or PARSER_BACKEND=ollama
OLLAMA_EXTRACT_MODEL=gemma4:e4b
OLLAMA_PARSER_MODEL=pillclerk

# Alias kept from IDEA.md §17
PILLCLERK_BACKEND=tinker
